# Copy to server/.env and fill in. Never commit the real .env.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/nextask
JWT_SECRET=<long random string, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))">
# Frontend URL(s) allowed to call the API, comma-separated
CLIENT_ORIGIN=http://localhost:3000
# PORT is set automatically on Render; 5000 is used locally
